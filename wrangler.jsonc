{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kevin-bongcawel-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-12",
  "upload_source_maps": true,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // REQUIRED: without this, matching assets are served directly
    // and your Worker (and the rate limiter) never runs.
    "run_worker_first": true
  },

  "ratelimits": [
    {
      "name": "ratelimit",          // binding name → env.ratelimit
      "namespace_id": "22",         // keep your existing namespace
      "simple": {
        "limit": 100,               // requests per period, per Cloudflare location
        "period": 10                // must be 10 or 60
      }
    }
  ],
  "services": [
    { "binding": "INVOKER", "service": "invoker" }
  ],
  "routes": [
  { "pattern": "bio.home-security.uk", "custom_domain": true }
]
}

