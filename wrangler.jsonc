{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kevin-bongcawel-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  },
  "routes": [
    {
      "pattern": "bio.home-security.uk",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "ratelimits": [
    {
      "name": "ratelimit",
      "namespace_id": "22",
      "simple": {
        "limit": 10,
        "period": 10
      }
    }
  ]
}
